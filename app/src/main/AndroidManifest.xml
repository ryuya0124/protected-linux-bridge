<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries>
    <package android:name="com.android.virtualization.terminal" />
  </queries>
  <application android:name=".BridgeApplication" android:forceQueryable="true" android:icon="@drawable/ic_terminal" android:label="@string/app_name" android:theme="@style/Theme.ProtectedLinux" android:allowBackup="false" android:supportsRtl="true">
    <activity android:name=".MainActivity" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name=".DesktopActivity" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden" android:exported="false" android:theme="@style/Theme.ProtectedLinux" android:windowSoftInputMode="adjustResize" />
    <service android:name=".MicrophoneService" android:exported="false" android:foregroundServiceType="microphone" />
  </application>
</manifest>
