# Preserve the bundled upstream source/license bytes.
app/src/main/assets/novnc/** -whitespace
third_party/novnc/** -whitespace
third_party/gpu/** -whitespace

# Unified diff blank context lines contain a significant single space.
tools/crosvm_preallocated_ram.patch whitespace=-blank-at-eol
tools/crosvm_android_headless.patch whitespace=-blank-at-eol,-blank-at-eof
tools/crosvm_gpu_diagnostics.patch whitespace=-blank-at-eol
kernels/android-gpu/guest-bound-dma-sync.patch whitespace=-blank-at-eol,-blank-at-eof
tools/crosvm_android_surface.patch whitespace=-blank-at-eol
tools/gfxstream_android_vulkan.patch whitespace=-blank-at-eol
native/owned_display/source-overlays/*.patch whitespace=-blank-at-eol,-blank-at-eof
