+static PLB_ANDROID_WINDOW: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static PLB_ANDROID_OWNER: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+pub fn plb_set_android_window(window: usize, owner: u32) {
+    PLB_ANDROID_OWNER.store(owner, std::sync::atomic::Ordering::SeqCst);
+    PLB_ANDROID_WINDOW.store(window, std::sync::atomic::Ordering::SeqCst);
+}
+pub fn plb_android_window_is_active() -> bool {
+    PLB_ANDROID_WINDOW.load(std::sync::atomic::Ordering::SeqCst) != 0
+        && PLB_ANDROID_OWNER.load(std::sync::atomic::Ordering::SeqCst) == std::process::id()
+}
