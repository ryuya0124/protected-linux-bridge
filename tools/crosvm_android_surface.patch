+/// Internal JNI launcher entry; argv and the native window belong to this root process.
+#[no_mangle]
+pub unsafe extern "C" fn plb_crosvm_surface_main(
+    argc: i32,
+    argv: *const *const std::ffi::c_char,
+    window: usize,
+) -> i32 {
+    if argc < 1 || argc > 160 || argv.is_null() {
+        return 70;
+    }
+    let mut arguments = Vec::new();
+    for index in 0..argc as usize {
+        let pointer = *argv.add(index);
+        if pointer.is_null() {
+            return 71;
+        }
+        let argument = std::ffi::CStr::from_ptr(pointer);
+        if argument.to_bytes().len() > 4096 {
+            return 72;
+        }
+        match argument.to_str() {
+            Ok(value) => arguments.push(value.to_owned()),
+            Err(_) => return 73,
+        }
+    }
+    rutabaga_gfx::plb_set_android_window(window, std::process::id());
+    syslog::early_init();
+    let result = crosvm_main(arguments);
+    match &result {
+        Ok(code) => *code as i32,
+        Err(error) => {
+            eprintln!("PLB_SURFACE_VMM_ERROR {error:?}");
+            error_to_exit_code(&result)
+        }
+    }
+}
